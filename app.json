{
  "expo": {
    "name": "CareNest",
    "slug": "carenest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "carenest",
    "userInterfaceStyle": "light",
    "primaryColor": "#d954b2",
    "splash": {
      "backgroundColor": "#f1a2d2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carenestbooking.app",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver relevant and personalized ads to you.",
        "NSPhotoLibraryUsageDescription": "CareNest requires access to your photo library to select a profile photo and upload verification documents."
      }
    },
    "android": {
      "package": "com.carenestbooking.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f1a2d2",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "CareNest requires access to your photo library to select a profile photo and upload verification documents."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3496568058228119~8151287836",
          "iosAppId": "ca-app-pub-3496568058228119~7037691726",
          "userTrackingUsageDescription": "This identifier will be used to deliver relevant and personalized ads to you."
        }
      ],
      "expo-tracking-transparency"
    ],
    "extra": {
      "eas": {
        "projectId": "b151a442-a64f-45df-96e0-31ee10b5570c"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3496568058228119~8151287836",
    "ios_app_id": "ca-app-pub-3496568058228119~7037691726"
  }
}
