{
  "expo": {
    "name": "CareNest",
    "slug": "carenest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "carenest",
    "userInterfaceStyle": "light",
    "primaryColor": "#d954b2",
    "splash": {
      "backgroundColor": "#f1a2d2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carenest.app",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver relevant and personalized ads to you."
      }
    },
    "android": {
      "package": "com.carenest.app",
      "adaptiveIcon": {
        "backgroundColor": "#f1a2d2",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3496568058228119~8151287836",
          "iosAppId": "ca-app-pub-3496568058228119~7037691726",
          "userTrackingUsageDescription": "This identifier will be used to deliver relevant and personalized ads to you."
        }
      ],
      "expo-tracking-transparency"
    ]
  }
}
